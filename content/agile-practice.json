{
  "key": "agile-practice",
  "category": "Training",
  "title": "Agile in Practice",
  "lead": "A practical training programme focused on applying agile principles and practices day-to-day in teams and organisations.",
  "sections": [
    {
      "heading": "Overview",
      "type": "text",
      "body": "Agile in Practice is a hands-on training programme that goes beyond theory. Participants learn by doing — working through realistic scenarios, facilitation exercises and retrospectives that build practical agile skills. It is suitable for teams at the start of or mid-way through an agile transformation."
    },
    {
      "heading": "ITOM Perspective",
      "type": "text",
      "body": "Agile in Practice training is used in ITOM engagements to rapidly build agile capability in teams that are adopting new ways of working as part of an operating model change. It complements Agile Coaching by providing a structured knowledge foundation."
    },
    {
      "heading": "Programme Content",
      "type": "list",
      "items": [
        {
          "term": "Agile Values & Principles",
          "desc": "The Agile Manifesto and what it means in practice."
        },
        {
          "term": "Scrum Framework",
          "desc": "Roles, ceremonies and artefacts for iterative delivery."
        },
        {
          "term": "Kanban & Flow",
          "desc": "Visualising work, limiting WIP and improving flow."
        },
        {
          "term": "Retrospectives",
          "desc": "Structured reflection and continuous improvement."
        },
        {
          "term": "Agile at Scale",
          "desc": "Introduction to scaling frameworks — SAFe, LeSS, Spotify."
        }
      ]
    },
